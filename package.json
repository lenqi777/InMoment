{
  "name": "inmoment",
  "version": "0.10.0",
  "private": true,
  "description": "本地优先的情境化灵感捕捉工具 · Windows MVP",
  "main": "src/main/main.cjs",
  "license": "MIT",
  "author": "InMoment contributors",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node scripts/launch.cjs",
    "dev": "node scripts/launch.cjs",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "asr:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-offline-asr.ps1",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "package": "node scripts/package.cjs",
    "package:minimal": "node scripts/package.cjs --minimal"
  },
  "devDependencies": {
    "electron": "44.7.2"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1"
  }
}
